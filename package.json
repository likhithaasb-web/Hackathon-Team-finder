{
  "name": "hackmate",
  "version": "1.0.0",
  "description": "HackMate — Real-Time Hackathon Team Finder",
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "start": "npm --prefix server start",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server test",
    "build": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": ["hackathon", "team-finder", "react", "express", "socketio", "mongodb"],
  "author": "HackMate Team",
  "license": "MIT"
}
